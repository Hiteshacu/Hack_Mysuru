# OPTIONAL. The app works fully without any key (built-in rules write the comments and viva questions).
#
# To turn on the AI reviewer:
#   1. Copy this file and name the copy  .env.local  (same folder as package.json)
#   2. Paste ONE key below after the = sign
#   3. Stop the dev server (Ctrl+C) and run  npm run dev  again
#
# Never share keys or commit .env.local to GitHub.

# Groq: free tier, no credit card. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: a different Groq model (default openai/gpt-oss-120b; faster: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Claude (paid). Used only if GROQ_API_KEY is empty.
# ANTHROPIC_API_KEY=

# Real SMS for "Notify others" (optional). Without these the SMS is simulated and students still get
# the in-app notification. Twilio trial accounts can only text numbers you have verified.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx

# Real phone numbers for demo students (kept out of the code). Indian 10-digit numbers get +91 automatically.
# Placeholder numbers (+91 90000 0000x) are never sent to Twilio.
# DEMO_PHONES=hitesh:9XXXXXXXXX

# HOSTING ON VERCEL: data must live in Redis (serverless functions can't keep files).
# Vercel dashboard → your project → Storage → Create → Upstash (Redis) → Connect. That adds these automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
